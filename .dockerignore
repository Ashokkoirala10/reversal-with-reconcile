# Version control
.git/
.gitignore
.gitattributes

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Local virtual environments
.venv/
venv/
ENV/
env/
reversa/
reconc/

# Django runtime state & uploads (mounted via volumes or generated at build time)
db.sqlite3*
media/
staticfiles/

# Secrets & environment files (injected at runtime via docker-compose or orchestrator)
.env*
!.env.example

# IDEs, editors & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Project documentation & repo metadata not needed in production container
README.md
TECHNICAL_DOCUMENTATION.md
System_Features_Overview_Email.txt

# Testing & CI artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Container & orchestration definitions
Dockerfile*
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# Build & packaging artifacts
build/
dist/
*.egg-info/
*.egg

# Logs & temporary files
*.log
tmp/
temp/
