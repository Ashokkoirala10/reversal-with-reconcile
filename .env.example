# Copy this file to .env and fill in real values before running the app —
# locally (`python manage.py runserver`) or via `docker compose up`. Never
# commit the real .env (see .gitignore).

# --- Django -------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Leave unset only for local/dev use — settings.py falls back to an
# insecure placeholder value if this is blank.
DJANGO_SECRET_KEY=
# Set to False for anything other than your own machine.
DJANGO_DEBUG=True
# Comma-separated hostnames/IPs this app will be served as, e.g.
# reversal.sct.com.np,10.0.0.5 — "*" is fine for local/dev only.
DJANGO_ALLOWED_HOSTS=*

# --- SMTP — the system account used for the scheduler's dispute/timeout
# alert + daily report emails, and the fallback for any user/department
# who hasn't set up their own account on the "Mail settings" tab. --------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_ENCRYPTION=tls

# Signature block appended to an outgoing email when the sender has no
# per-user override configured on the "Mail settings" tab.
MAIL_SIGNATURE_NAME=
MAIL_SIGNATURE_TITLE=Tech Operation Department
MAIL_SIGNATURE_COMPANY=Smart Choice Technologies Ltd. (SCT)
MAIL_SIGNATURE_PHONE=
MAIL_SIGNATURE_ADDRESS=
MAIL_SIGNATURE_TOLL_FREE=
MAIL_SIGNATURE_WEBSITE=www.sct.com.np

# --- Postgres -------------------------------------------------------------
# Leave POSTGRES_DB blank to run this app on sqlite instead (e.g. local dev
# without Docker) — see reversal_project/settings.py's DATABASES block.
# docker-compose.yml's "db" service is seeded from these same values, and
# overrides POSTGRES_HOST/PORT for the "app" service to reach it over the
# compose network (the localhost default below is only correct when
# Postgres runs directly on this machine, outside Docker).
POSTGRES_DB=sct_reversal_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Switch DB (read-only source for "Fetch from DB" instead of uploading
# the exported .xlsx by hand) — see core/switch_db.py.
SWITCH_DB_HOST=
SWITCH_DB_PORT=5432
SWITCH_DB_NAME=
SWITCH_DB_USER=
SWITCH_DB_PASSWORD=
